{
  "name": "@red-cup-engineering/koios-news-site-engine",
  "version": "0.1.11",
  "private": false,
  "type": "module",
  "description": "The Koios.News public website, built from the parent service section's publication inputs.",
  "engines": {
    "node": ">=24.2"
  },
  "exports": {
    "./frozen-lockfile": "./release/pnpm-lock.yaml",
    "./release": "./src/release.mjs",
    "./release-observation": "./src/release-observation.mjs",
    "./build": "./src/build.mjs",
    "./carrier": "./src/carrier.mjs",
    "./build-property": "./scripts/build-property.mjs",
    "./release-binding": "./release/koios-news-primary-binding.json",
    "./discovery-audit": "./src/discovery-audit.mjs"
  },
  "scripts": {
    "build": "node scripts/build-property.mjs",
    "test": "node --test test/*.test.mjs",
    "discovery:audit": "node scripts/audit-discovery.mjs",
    "test:discovery": "node --test test/discovery-audit.test.mjs",
    "build:publication": "node scripts/build-property.mjs"
  },
  "bin": {
    "koios-website-build": "./scripts/build-property.mjs",
    "koios-website-release": "./scripts/release-property.mjs"
  },
  "devDependencies": {},
  "dependencies": {
    "@red-cup-engineering/csl-json-services-section": "0.2.2",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "0.3.1",
    "@red-cup-engineering/json-services-section": "0.4.0",
    "@red-cup-engineering/computer-serialized-content-engineering-services-section": "0.2.2",
    "sharp": "0.35.5",
    "wrangler": "4.127.1",
    "@red-cup-engineering/computer-text-content-engineering-services-section": "0.1.0",
    "@red-cup-engineering/web-theming-service": "0.0.7",
    "@red-cup-engineering/html-engineering-services-section": "0.1.4",
    "@red-cup-engineering/computer-triplet-serialized-content-engineering-services-section": "0.1.2",
    "@red-cup-engineering/image-authoring-service": "0.1.0",
    "@red-cup-engineering/signcell": "0.12.1"
  },
  "packageManager": "pnpm@11.28.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/koios-news-site-engine.git"
  },
  "files": [
    "pnpm-workspace.yaml",
    "src",
    "scripts",
    "release",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "registry": "https://registry.561.group/"
  },
  "registryConsumption": {
    "frozenLockfile": "./release/pnpm-lock.yaml"
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
