    "check": "node --input-type=module -e 'await import(\"./src/news-line.mjs\")' && node --check src/operations.mjs && node --check src/news-line/editorial-agency.mjs && node --check src/news-line/commissions.mjs && node --check src/news-line/stages.mjs && node --check src/news-line/submissions.mjs && node --check src/offline-publication.mjs",
    "describe": "node src/service-section.mjs describe",
    "settle": "node src/service-section.mjs settle-message",
    "test": "node --test test/*.test.mjs",
    "site:build": "node scripts/build-public-site.mjs --out .public",
    "site:release": "node scripts/release-site.mjs",
    "article:correct": "node scripts/correct-article.mjs",
    "feedback:collect": "node scripts/collect-feedback.mjs",
